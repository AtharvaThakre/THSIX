# Shopify Configuration
VITE_SHOPIFY_STORE_DOMAIN=https://19sjnp-gx.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=be59fa0cf086500d7b6456e64f233866

# App Configuration
VITE_APP_TITLE=THSIX
VITE_APP_URL=https://your-domain.vercel.app

# Shiprocket Configuration (Backend Only - NOT prefixed with VITE_)
SHIPROCKET_API_KEY=your_shiprocket_api_key
SHIPROCKET_API_SECRET=your_shiprocket_api_secret
SHIPROCKET_BASE_URL=https://checkout-api.shiprocket.com
# Grams used when a Shopify variant has no weight (couriers need one to price shipping)
SHIPROCKET_DEFAULT_WEIGHT_GRAMS=1000
# Random string; protects /api/catalog/sync (Vercel Cron sends it automatically)
CRON_SECRET=
# Optional: Shopify custom app Admin API token (write_orders, read_orders) so paid
# Shiprocket orders are created in Shopify and stock is decremented
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Website Configuration
WEBSITE_BASE_URL=https://www.thsix.com
CHECKOUT_SUCCESS_URL=/checkout/success
CHECKOUT_FAILURE_URL=/checkout/failure

# Optional: Analytics and SEO
