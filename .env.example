# Browser (Vite) — Shopify Storefront API, public by design
VITE_SHOPIFY_STORE_DOMAIN=https://19sjnp-gx.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Server (Vercel functions in /api) — never prefix these with VITE_
# Shiprocket Checkout (Custom channel) keys for the thsix.com seller
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=
SHIPROCKET_BASE_URL=https://checkout-api.shiprocket.com
WEBSITE_BASE_URL=https://www.thsix.com
CHECKOUT_SUCCESS_URL=/checkout/success
# Grams used when a Shopify variant has no weight (couriers need one to price shipping)
SHIPROCKET_DEFAULT_WEIGHT_GRAMS=1000
# Random string; protects /api/catalog/sync (Vercel Cron sends it automatically)
CRON_SECRET=
# Optional: Shopify custom app Admin API token (read_orders, write_orders) so Shiprocket
# orders are created in Shopify and stock is decremented
SHOPIFY_ADMIN_ACCESS_TOKEN=
