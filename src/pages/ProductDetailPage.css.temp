/* ─── Product Images ──────────────────────────────────────── */
.product-detail__images {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.product-detail__main-image {
  width: 100%;
  background-color: #f2f2f0;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 1;
  position: relative;
  transition: opacity 0.3s ease;
}

.product-detail__main-image img,
.product-detail__main-image shopify-media {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.product-detail__thumbnails-container {
  position: relative;
}

.product-detail__thumbnails {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
  gap: 8px;
  padding: 0;
  overflow-x: auto;
  overflow-y: hidden;
}

@media (max-width: 768px) {
  .product-detail__thumbnails {
    display: flex;
    overflow-x: scroll;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .product-detail__thumbnails::-webkit-scrollbar {
    display: none;
  }
  
  .product-detail__thumbnail {
    min-width: 80px;
    width: 80px;
  }
}

.product-detail__thumbnail {
  width: 80px;
  height: 80px;
  background-color: #f2f2f0;
  border-radius: 6px;
  overflow: hidden;
  cursor: pointer;
  border: none;
  flex-shrink: 0;
  transition: all 0.2s ease;
  scroll-snap-align: start;
  padding: 0;
  display: block;
}

.product-detail__thumbnail:hover {
  opacity: 0.8;
  transform: scale(1.02);
}

.product-detail__thumbnail--active {
  opacity: 1;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.product-detail__thumbnail img,
.product-detail__thumbnail shopify-media {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
