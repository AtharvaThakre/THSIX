# THSIX Hydrogen environment.
#
# Local: copy to .env (gitignored).  Production: Shopify admin > Hydrogen > THSIX storefront >
# Storefront settings > Environments and variables (mark server-only values as "Secret").
# Never commit real secrets. Values below are placeholders or public identifiers.

# ══ PUBLIC (safe in the browser) ══════════════════════════════════════════════════════════
# On Oxygen these four are injected automatically for the linked storefront; locally
# `npx shopify hydrogen link` + `npx shopify hydrogen env pull` writes them.
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_CHECKOUT_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=public-storefront-api-token
# Hydrogen storefront ID: numeric ("1000182960") or the GID from .shopify/project.json
# ("gid://shopify/HydrogenStorefront/1000182960"). Required for Shopify analytics / Live View:
# without it no Monorail events are sent (never a placeholder "0").
PUBLIC_STOREFRONT_ID=

# Shop GID (Shopify analytics shopId). Not the storefront ID above.
PUBLIC_SHOPIFY_SHOP_ID=gid://shopify/Shop/0000000000
# Optional: GA4 is disabled when empty
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=0000000000000000

# ══ SERVER-ONLY SECRETS (never exposed to the browser) ════════════════════════════════════
# Required by Hydrogen (Oxygen injects one automatically)
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: private Storefront token for server-side catalogue reads (Oxygen injects it)
PRIVATE_STOREFRONT_API_TOKEN=

# Shiprocket Checkout (Custom channel) — Shiprocket Checkout > Settings > API.
# Without them /api/checkout/token answers 500 "Checkout is not configured yet."
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=

# Contact form (Resend). Without the key /api/contact answers 500 with a support-email hint.
RESEND_API_KEY=

# Shopify Admin API access, used to create Shiprocket orders in Shopify and sync fulfillment.
# Optional: without it orders stay in Shiprocket only. Scopes: read_orders, write_orders,
# read_customers, write_customers, read_products, read_merchant_managed_fulfillment_orders,
# write_merchant_managed_fulfillment_orders.
# Dev Dashboard app: client ID + secret (Settings page); the server requests a ~24h token itself.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Legacy custom app: a permanent shpat_ token. Used when no client credentials are set, or as
# the fallback if the token request fails.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Meta Conversions API access token. Optional: without it the server-side Purchase is skipped.
META_CAPI_TOKEN=

# Bearer token for /api/catalog/sync (the endpoint refuses every call while this is empty)
CRON_SECRET=
# Shared secret the Shiprocket webhooks must carry (?token=... in the registered URL, or an
# X-Webhook-Token / X-Api-Key header). Strongly recommended; webhooks are open while empty.
WEBHOOK_SECRET=

# ══ SERVER-ONLY CONFIGURATION (not secret) ════════════════════════════════════════════════
SHIPROCKET_BASE_URL=https://checkout-api.shiprocket.com
WEBSITE_BASE_URL=https://www.thsix.com
CHECKOUT_SUCCESS_URL=/checkout/success
# Grams used when a Shopify variant has no weight (couriers need one to price shipping)
SHIPROCKET_DEFAULT_WEIGHT_GRAMS=1000
SUPPORT_EMAIL=support@thsix.com
CONTACT_FROM_EMAIL=THSIX Contact <noreply@thsix.com>
# Pixel ID for CAPI (defaults to PUBLIC_META_PIXEL_ID)
META_PIXEL_ID=
# Emergency switch: "true" sends the Content-Security-Policy as Report-Only (default: enforced)
CSP_REPORT_ONLY=
